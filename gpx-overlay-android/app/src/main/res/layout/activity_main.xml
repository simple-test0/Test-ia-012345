<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_bg">

    <com.orienteering.gpxoverlay.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barre du haut -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flag" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenMap"
            style="@style/TopButton"
            android:drawableStart="@drawable/ic_map"
            android:text="@string/open_map" />

        <Button
            android:id="@+id/btnOpenTrack"
            style="@style/TopButton"
            android:drawableStart="@drawable/ic_route"
            android:text="@string/open_track" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            android:tint="@color/ink" />
    </LinearLayout>

    <!-- Accueil : bienvenue + dernière session + sessions précédentes -->
    <ScrollView
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="84dp"
        android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp">

    <LinearLayout
        android:id="@+id/emptyState"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flag" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/welcome_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/welcome_text"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEmptyMap"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary"
            android:drawableStart="@drawable/ic_map"
            android:drawableTint="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="18dp"
            android:text="@string/open_map_long"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEmptyTrack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary"
            android:drawableStart="@drawable/ic_route"
            android:drawableTint="@color/ink"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="18dp"
            android:text="@string/open_track_long"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEmptyGarmin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary"
            android:drawableStart="@drawable/ic_watch"
            android:drawableTint="@color/ink"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="18dp"
            android:text="@string/import_garmin"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/welcomeTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/welcome_tip"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/resumeHeader"
        style="@style/SectionHeader"
        android:text="@string/resume" />

    <LinearLayout
        android:id="@+id/lastSession"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lastThumb"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@color/map_bg"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lastTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lastSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_primary"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="4dp"
                android:drawableTint="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/resume"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnLastMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more"
                android:tint="@color/muted" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/previousHeader"
        style="@style/SectionHeader"
        android:text="@string/previous_sessions" />

    <LinearLayout
        android:id="@+id/sessionList"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="4dp" />
    </LinearLayout>
    </ScrollView>

    <!-- Bouton flottant « voir toute la carte » -->
    <ImageButton
        android:id="@+id/btnFit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/fit_view"
        android:elevation="6dp"
        android:src="@drawable/ic_fit"
        android:tint="@color/ink" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- Panneau du bas -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <!-- Statistiques (défilent si besoin) -->
        <HorizontalScrollView
            android:id="@+id/statsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <LinearLayout style="@style/StatItem">
                    <TextView android:id="@+id/statDist" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_distance" />
                </LinearLayout>

                <LinearLayout style="@style/StatItem">
                    <TextView android:id="@+id/statTime" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_time" />
                </LinearLayout>

                <LinearLayout style="@style/StatItem">
                    <TextView android:id="@+id/statPace" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_pace" />
                </LinearLayout>

                <LinearLayout android:id="@+id/statGainBox" style="@style/StatItem">
                    <TextView android:id="@+id/statGain" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_gain" />
                </LinearLayout>

                <LinearLayout android:id="@+id/statLossBox" style="@style/StatItem">
                    <TextView android:id="@+id/statLoss" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_loss" />
                </LinearLayout>

                <LinearLayout android:id="@+id/statHrBox" style="@style/StatItem">
                    <TextView android:id="@+id/statHr" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/statHrLabel" style="@style/StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_hr" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Légende des couleurs + bouton du graphique -->
        <LinearLayout
            android:id="@+id/legendRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/legend"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/legendBar"
                    android:layout_width="56dp"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/legendLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:drawableStart="@drawable/ic_chart"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ink"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/profile"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Graphique : allure, altitude, FC -->
        <LinearLayout
            android:id="@+id/profileBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipPace" style="@style/Chip" android:text="@string/metric_pace" />
                <TextView android:id="@+id/chipEle" style="@style/Chip" android:text="@string/metric_ele" />
                <TextView android:id="@+id/chipHr" style="@style/Chip" android:text="@string/metric_hr" />
            </LinearLayout>

            <com.orienteering.gpxoverlay.ProfileView
                android:id="@+id/profile"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/line" />

        <!-- Barre des modes -->
        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp">

            <Button android:id="@+id/btnMap" style="@style/BarButton" android:drawableTop="@drawable/ic_explore" android:text="@string/mode_map" />
            <Button android:id="@+id/btnTrace" style="@style/BarButton" android:drawableTop="@drawable/ic_move" android:text="@string/mode_trace" />
            <Button android:id="@+id/btnCalib" style="@style/BarButton" android:drawableTop="@drawable/ic_target" android:text="@string/mode_calib" />
            <Button android:id="@+id/btnControls" style="@style/BarButton" android:drawableTop="@drawable/ic_course" android:text="@string/mode_controls" />
            <Button android:id="@+id/btnReplay" style="@style/BarButton" android:drawableTop="@drawable/ic_replay" android:text="@string/mode_replay" />
        </LinearLayout>

        <!-- Calage par points -->
        <LinearLayout
            android:id="@+id/calibBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <Button android:id="@+id/btnUndo" style="@style/BarButton" android:drawableTop="@drawable/ic_undo" android:text="@string/undo" />
            <Button android:id="@+id/btnDone" style="@style/BarButton" android:drawableTop="@drawable/ic_check" android:text="@string/done" />
        </LinearLayout>

        <!-- Postes -->
        <LinearLayout
            android:id="@+id/controlsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <Button android:id="@+id/btnCtrlUndo" style="@style/BarButton" android:drawableTop="@drawable/ic_undo" android:text="@string/undo" />
            <Button android:id="@+id/btnCtrlClear" style="@style/BarButton" android:drawableTop="@drawable/ic_delete" android:text="@string/clear" />
            <Button android:id="@+id/btnSplits" style="@style/BarButton" android:drawableTop="@drawable/ic_list" android:text="@string/splits_short" />
            <Button android:id="@+id/btnCtrlDone" style="@style/BarButton" android:drawableTop="@drawable/ic_check" android:text="@string/done" />
        </LinearLayout>

        <!-- Replay -->
        <LinearLayout
            android:id="@+id/replayBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_play"
                android:contentDescription="@string/play"
                android:elevation="2dp"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFF" />

            <SeekBar
                android:id="@+id/replaySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <Button
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-medium"
                android:minWidth="56dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="×10"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnReplayDone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/done"
                android:src="@drawable/ic_close"
                android:tint="@color/ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- Panneau des temps intermédiaires -->
    <LinearLayout
        android:id="@+id/splitsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/splits"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />
                <TextView
                    android:id="@+id/splitsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSplitsClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="@color/ink" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/splitsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/splitsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingBottom="12dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Message temporaire avec action -->
    <LinearLayout
        android:id="@+id/snackbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_snackbar"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/snackText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="14dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/snackAction"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFB38A"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
