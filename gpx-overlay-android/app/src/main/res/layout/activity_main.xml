<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.orienteering.gpxoverlay.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2F2F2"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:textColor="#222222"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2F2F2"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Barre des modes -->
    <LinearLayout
        android:id="@+id/modeBar"
        style="@style/BottomBar">

        <Button android:id="@+id/btnMap" style="@style/BarButton" android:text="@string/mode_map" />
        <Button android:id="@+id/btnTrace" style="@style/BarButton" android:text="@string/mode_trace" />
        <Button android:id="@+id/btnCalib" style="@style/BarButton" android:text="@string/mode_calib" />
        <Button android:id="@+id/btnControls" style="@style/BarButton" android:text="@string/mode_controls" />
        <Button android:id="@+id/btnReplay" style="@style/BarButton" android:text="@string/mode_replay" />
    </LinearLayout>

    <!-- Calage par points -->
    <LinearLayout
        android:id="@+id/calibBar"
        style="@style/BottomBar"
        android:visibility="gone">

        <Button android:id="@+id/btnUndo" style="@style/BarButton" android:text="@string/undo" />
        <Button android:id="@+id/btnDone" style="@style/BarButton" android:text="@string/done" />
    </LinearLayout>

    <!-- Postes -->
    <LinearLayout
        android:id="@+id/controlsBar"
        style="@style/BottomBar"
        android:visibility="gone">

        <Button android:id="@+id/btnCtrlUndo" style="@style/BarButton" android:text="@string/undo" />
        <Button android:id="@+id/btnCtrlClear" style="@style/BarButton" android:text="@string/clear" />
        <Button android:id="@+id/btnSplits" style="@style/BarButton" android:text="@string/splits_short" />
        <Button android:id="@+id/btnCtrlDone" style="@style/BarButton" android:text="@string/done" />
    </LinearLayout>

    <!-- Replay -->
    <LinearLayout
        android:id="@+id/replayBar"
        style="@style/BottomBar"
        android:gravity="center_vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPlay"
            style="@style/BarButton"
            android:layout_width="56dp"
            android:layout_weight="0"
            android:text="▶" />

        <SeekBar
            android:id="@+id/replaySeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000" />

        <Button
            android:id="@+id/btnSpeed"
            style="@style/BarButton"
            android:layout_width="64dp"
            android:layout_weight="0"
            android:text="×10" />

        <Button
            android:id="@+id/btnReplayDone"
            style="@style/BarButton"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="@string/done" />
    </LinearLayout>
</LinearLayout>
