<?xml version="1.0" encoding="utf-8"?>
<!-- Uniquement des connexions chiffrées (HTTPS), avec les autorités de certification du système. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
